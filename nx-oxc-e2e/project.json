{
  "name": "nx-oxc-e2e",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "nx-oxc-e2e/src",
  "implicitDependencies": ["nx-oxc"],
  "targets": {
    "e2e": {
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}",
        "{workspaceRoot}\\coverage\\nx-oxc-e2e"
